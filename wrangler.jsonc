{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "msaproperty",
  "main": "src/index.js",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "MSA_PROPERTY_DB"
    }
  ]
}
